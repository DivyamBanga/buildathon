+import unittest
+
+from sqlglot import exp, parse_one
+from sqlglot.dialects import DuckDB
+
+
+class TestMyDuck(unittest.TestCase):
+    def test_generate(self):
+        class MyDuck(DuckDB):
+            class Generator(DuckDB.Generator):
+                SUPPORTED_JSON_PATH_PARTS = {exp.JSONPathKey, exp.JSONPathRoot}
+
+        self.assertEqual(parse_one("SELECT 1").sql(dialect=MyDuck), "SELECT 1")
